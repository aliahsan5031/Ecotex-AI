# Copy this file to .env and fill it in. .env is git-ignored.

# Optional. Without a key the app still works and uses its built-in explanations.
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# ECOTEX_USE_LLM=1          # set to 0 to turn off the AI summary even if a key is present
# ECOTEX_DATA=data/ecotex_dataset.csv
